# Yahoo Finance API on RapidAPI: https://rapidapi.com/apidojo/api/yahoo-finance1
RAPIDAPI_KEY=

# Local LLM served by Ollama, used by `finratio ask` and `finratio chat`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Analysis defaults
RISK_FREE_RATE=0.05
DEFAULT_BENCHMARK=SPY
DEFAULT_PERIOD=1y
